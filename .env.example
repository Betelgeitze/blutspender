# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.example .env && chmod 600 .env

# Telegram bot token from BotFather
BOT_API_KEY=

# Postgres. POSTGRES_* are read by both the app and the postgres container
# (which uses them to initialise the database on first start).
POSTGRES_DB=blutspender
POSTGRES_USER=blutspender
POSTGRES_PASSWORD=

# Where the app connects. docker-compose overrides these to the compose service,
# so leave them alone unless you are running the scripts outside Docker.
DB_HOST=database
PORT_ID=5432

# Unbuffered stdout so print() reaches `docker compose logs` immediately.
PYTHONUNBUFFERED=1

# --- How the bot receives updates -------------------------------------------
# webhook: Telegram POSTs to WEBHOOK_DOMAIN through Caddy. Needs the three
#          settings below and ports 80+443 open. This is the VPS default.
# polling: the bot calls getUpdates in a loop. No domain, no TLS, no open port —
#          use it locally on Windows and as the break-glass fallback.
#
# BOT_MODE and COMPOSE_PROFILES must agree: the "webhook" profile is what starts
# Caddy. For polling, set BOT_MODE=polling and leave COMPOSE_PROFILES empty.
BOT_MODE=webhook
COMPOSE_PROFILES=webhook

# The hostname Telegram connects to, and the name Caddy requests a certificate
# for. A free DuckDNS subdomain works: <you>.duckdns.org, pointed at the VPS IP.
# Must resolve to this server before the first `docker compose up -d`.
WEBHOOK_DOMAIN=

# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header; anything arriving without it is dropped. Generate once with:
#   openssl rand -hex 32
# Allowed characters are A-Z, a-z, 0-9, _ and - (1-256 chars).
WEBHOOK_SECRET=

# Optional: your own Telegram chat id, so failing cron jobs message you.
# ADMIN_CHAT_ID=
