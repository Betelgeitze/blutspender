# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.example .env && chmod 600 .env

# Telegram bot token from BotFather
BOT_API_KEY=

# Postgres. POSTGRES_* are read by both the app and the postgres container
# (which uses them to initialise the database on first start).
POSTGRES_DB=blutspender
POSTGRES_USER=blutspender
POSTGRES_PASSWORD=

# Where the app connects. docker-compose overrides these to the compose service,
# so leave them alone unless you are running the scripts outside Docker.
DB_HOST=database
PORT_ID=5432

# Unbuffered stdout so print() reaches `docker compose logs` immediately.
PYTHONUNBUFFERED=1
