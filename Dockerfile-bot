FROM python:3.10

WORKDIR /bot
COPY /bot/requirements.txt .
RUN pip install -r requirements.txt

COPY ./bot .
COPY ./support ./support
COPY ./config.json .
RUN chmod +x ./entrypoint.sh

# Run unprivileged, with the pgeocode postal-code dataset baked in rather than
# downloaded from geonames.org on first use — a container that has to reach
# geonames before it can answer anything is a container that restart-loops
# whenever geonames is slow. Rebuild the image to refresh the data.
ENV HOME=/home/app PGEOCODE_DATA_DIR=/home/app/.cache/pgeocode
RUN useradd --uid 10001 --home-dir /home/app --create-home app \
    && mkdir -p "$PGEOCODE_DATA_DIR" \
    && python -c "import json, pgeocode; c = json.load(open('config.json'))['country_code']; pgeocode.Nominatim(c); pgeocode.GeoDistance(c)" \
    && chown -R app:app /home/app /bot
USER app

# Webhook mode listens here. Not published to the host — Caddy reaches it over
# the compose network and is the only thing that should.
EXPOSE 8080

# entrypoint.sh branches on BOT_MODE (webhook or polling).
CMD ["./entrypoint.sh"]

